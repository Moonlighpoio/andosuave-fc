# Copia este archivo a .env y llena los valores antes de iniciar.

# Números de administradores (formato país sin + : 56911112222).
# Separa varios con coma. Solo ellos podrán administrar multas, listas y la página.
ADMIN_NUMBERS=

# ID del grupo de WhatsApp donde el bot responde y manda recordatorios.
# Se obtiene escribiendo "!grupo" (el bot lo responde). Ej: 56900000000-1234567890@g.us
GROUP_ID=

# Número externo que usará el bot. Si se indica, en la primera conexión
# muestra un codigo de emparejamiento (pairing code) en vez del QR.
PAIRING_NUMBER=

# Repo de la página (GitHub Pages) que el bot puede actualizar.
SITE_REPO_URL=https://github.com/Moonlighpoio/andosuave-fc
SITE_REPO=Moonlighpoio/andosuave-fc

# Token de GitHub (PAT fine-grained con permiso Contents: Read/Write sobre SITE_REPO)
# para que el bot pueda hacer push a la página. Vacío = el bot no publica.
GITHUB_TOKEN=

# Zona horaria y horarios de recordatorios (hora local).
TZ=America/Santiago
REMINDER_MULTAS_HOUR=19
REMINDER_MULTAS_MINUTE=0
REMINDER_LISTA_HOUR=11
REMINDER_LISTA_MINUTE=30
# Hora en que se envía la convocatoria de la próxima semana (lunes y jueves,
# tras el partido). El mensaje se genera con fecha, cancha, link y lista nueva.
REMINDER_CONVOCA_HOUR=21
REMINDER_CONVOCA_MINUTE=1

# Carpeta donde el bot guarda su estado (db.json, sesión, clon de la página).
# Si el bot vive dentro del repo (carpeta bot/), usa bot/data para no ensuciar git.
DATA_DIR=data

# Repo/sitio que el bot edita. Si el bot corre dentro del repositorio (bot/),
# apunta al raíz del repo con SITE_DIR=.. para editar config.js directamente.
SITE_DIR=data/site